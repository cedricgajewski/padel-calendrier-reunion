{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padel-calendrier-reunion",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/get-tournaments"]
  }
}
